rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // USERS COLLECTION
    // ==============================
    match /users/{userId} {
      allow read, write: if isSuperAdmin()
        || (isAdmin() && isSameHospital(resource.data.hospitalId))
        || (isHCW() && isSameUser(userId));

      // 👤 Only SUPER_ADMIN can create users
      allow create: if isSuperAdmin();
    }

    // ==============================
    // HOSPITALS COLLECTION
    // ==============================
    match /hospitals/{hospitalId} {
      allow read, write: if isSuperAdmin()
        || (isAdmin() && isSameHospital(hospitalId));
      
      // 🏥 Only SUPER_ADMIN can create hospitals
      allow create: if isSuperAdmin();
    }

    // ==============================
    // PATIENTS COLLECTION
    // ==============================
    match /patients/{patientId} {
      allow read, write: if isSuperAdmin()
        || (isAdmin() && isSameHospital(resource.data.hospitalId))
        || (isHCW() && isSameHospital(resource.data.hospitalId));
    }

    // ==============================
    // CONSULTATIONS COLLECTION
    // ==============================
    match /consultations/{consultationId} {
      allow read: if isSuperAdmin()
        || (isAdmin() && isSameHospital(resource.data.hospitalId))
        || (isHCW() && isSameHospital(resource.data.hospitalId));

      allow create, update: if (
        isSuperAdmin() || (isAdmin() && isSameHospital(request.resource.data.hospitalId)) || (isHCW() && isSameHospital(request.resource.data.hospitalId))
      ) && validConsultation(request.resource.data);
    }

    // ==============================
    // TASKS COLLECTION
    // ==============================
    match /tasks/{taskId} {
      allow read, write: if isSuperAdmin()
        || (isAdmin() && isSameHospital(resource.data.hospitalId))
        || (isHCW() && isSameHospital(resource.data.hospitalId));
    }

    // ==============================
    // HELPER FUNCTIONS
    // ==============================
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == "SUPER_ADMIN";
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == "ADMIN";
    }

    function isHCW() {
      return request.auth != null && request.auth.token.role == "HCW";
    }

    // ✅ Compare hospitalId in claim vs document
    function isSameHospital(hospitalId) {
      return request.auth != null && request.auth.token.hospitalId == hospitalId;
    }

    // ✅ User can only read/write their own profile
    function isSameUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ==============================
    // VALIDATION HELPERS
    // ==============================
    function isNumberInRange(n, min, max) {
      return n == null || (n is number && n >= min && n <= max);
    }

    function validConsultation(data) {
      // Optional vitals/measurements must be realistic when provided
      return
        isNumberInRange(data.weightKg, 0, 500) &&
        isNumberInRange(data.heightCm, 0, 300) &&
        (data.vitals == null || (
          isNumberInRange(data.vitals.temperatureC, 25, 45) &&
          isNumberInRange(data.vitals.pulseBpm, 20, 250) &&
          isNumberInRange(data.vitals.respirationRate, 5, 80) &&
          isNumberInRange(data.vitals.bpSystolic, 50, 300) &&
          isNumberInRange(data.vitals.bpDiastolic, 30, 200)
        ));
    }
  }
}
